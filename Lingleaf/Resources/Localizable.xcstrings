    "“%@” (= “%@”) + base verb = past negative: “didn't go”, not “didn't went”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”) + verbo en forma base = negación en pasado: “didn't go”, no “didn't went”."
          }
        }
      }
    },
    "“%@” (= “%@”) + base verb = present negative: “%@ like”, not “%@ likes”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”) + verbo en forma base = negación en presente: “%3$@ like”, no “%4$@ likes”."
          }
        }
      }
    },
    "“%@” (= “%@”) + past participle: it happened before another past moment: “had left”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”) + participio: pasó antes que otra cosa del pasado: “had left”."
          }
        }
      }
    },
    "“%@” (= “%@”) + past participle: it happened before now and still matters: “seen”, not “saw”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”) + participio: pasó antes y todavía importa: “seen”, no “saw”."
          }
        }
      }
    },
    "“%@” (= “%@”) + verb: the future.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”) + verbo: el futuro."
          }
        }
      }
    },
    "“%@” (= “%@”) + verb: an imagined result, or a polite request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”) + verbo: algo imaginado, o una petición amable."
          }
        }
      }
    },
    "“%@” (= “%@”): the negative of “%@” + verb.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” (= “%2$@”): la forma negativa de “%3$@” + verbo."
          }
        }
      }
    },
    "“%@” + base verb = past negative: “did not go”, not “did not went”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” + verbo en forma base = negación en pasado: “did not go”, no “did not went”."
          }
        }
      }
    },
    "“%@” + base verb = present negative: “%@ like”, not “%@ likes”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” + verbo en forma base = negación en presente: “%2$@ like”, no “%3$@ likes”."
          }
        }
      }
    },
    "“%@” + base verb tells someone not to do it: “Don't touch”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” + verbo en forma base sirve para prohibir: “Don't touch” = no toques."
          }
        }
      }
    },
    "“%@” + past participle: it happened before another past moment: “had left”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” + participio: pasó antes que otra cosa del pasado: “had left”."
          }
        }
      }
    },
    "“%@” + past participle: it happened before now and still matters: “seen”, not “saw”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” + participio: pasó antes y todavía importa: “seen”, no “saw”."
          }
        }
      }
    },
    "“%@” + pronoun at the end asks the listener to agree, like “right?”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” + pronombre al final pide que el otro confirme, como “¿verdad?”."
          }
        }
      }
    },
    "“%@” + verb: it is not allowed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” + verbo: está prohibido."
          }
        }
      }
    },
    "“%@” = “%@”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” = “%2$@”."
          }
        }
      }
    },
    "“%@” added to your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” se agregó a tu biblioteca."
          }
        }
      }
    },
    "“%@” can be “%@” or “%@”: the sentence's translation tells which.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” puede ser “%2$@” o “%3$@”: la traducción de la frase dice cuál."
          }
        }
      }
    },
    "“%@” deleted": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” eliminada"
          }
        }
      }
    },
    "“%@” is in your library.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está en tu biblioteca."
          }
        }
      }
    },
    "“%@” marked as known": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” marcada como conocida"
          }
        }
      }
    },
    "“%@” removed from Words": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitó “%@” de Palabras"
          }
        }
      }
    },
    "“%@” saved to Words": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” guardada en Palabras"
          }
        }
      }
    },
    "“%@” starts a question about the past.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” abre una pregunta sobre el pasado."
          }
        }
      }
    },
    "“%@” starts a question about the present.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” abre una pregunta sobre el presente."
          }
        }
      }
    },
    "“%@” will be removed from your library. Your saved words stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” se quitará de tu biblioteca. Tus palabras guardadas se conservan."
          }
        }
      }
    },
    "“%@”: the negative of “%@” + verb.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: la forma negativa de “%2$@” + verbo."
          }
        }
      }
    },
    "“'d better” (= “had better”) + verb: strong advice: “You'd better go”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“'d better” (= “had better”) + verbo: un consejo firme, “más te vale”: “You'd better go”."
          }
        }
      }
    },
    "“can” + verb: be able to, or be allowed to.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“can” + verbo: poder (ser capaz o tener permiso)."
          }
        }
      }
    },
    "“could” + verb: was able to, or it’s possible.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“could” + verbo: podía o podría."
          }
        }
      }
    },
    "“had better” + verb: strong advice: “You'd better go”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“had better” + verbo: un consejo firme, “más te vale”: “You'd better go”."
          }
        }
      }
    },
    "“it's” = “%@”; “its” (no apostrophe) = belonging to it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“it's” = “%@”; “its” (sin apóstrofo) = su, de una cosa o un animal."
          }
        }
      }
    },
    "“let's” (= “let us”) + verb: a suggestion to do something together: “Let's go”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“let's” (= “let us”) + verbo: una propuesta para hacer juntos: “Let's go”."
          }
        }
      }
    },
    "“may” + verb: maybe, or permission.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“may” + verbo: quizás, o permiso."
          }
        }
      }
    },
    "“might” + verb: maybe.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“might” + verbo: quizás, puede que…"
          }
        }
      }
    },
    "“must” + verb: it is necessary, or it is surely true.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“must” + verbo: hay que hacerlo, o seguro que es así."
          }
        }
      }
    },
    "“shall” + verb: the future, or an offer (“Shall we go?”).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“shall” + verbo: el futuro, o una propuesta (“Shall we go?” = ¿Vamos?)."
          }
        }
      }
    },
    "“should” + verb: advice, what is right to do.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“should” + verbo: un consejo (debería…)."
          }
        }
      }
    },
    "“who's” = “%@”; “whose” = of whom: “Whose book?”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“who's” = “%@”; “whose” = de quién: “Whose book?”"
          }
        }
      }
    },
    "“will” + verb: the future.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“will” + verbo: el futuro (iré, irás…)."
          }
        }
      }
    },
    "“would” + verb: what would happen, or a polite request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“would” + verbo: lo que pasaría (iría, haría…) o un pedido amable."
          }
        }
      }
    }
  },
  "version": "1.0"
